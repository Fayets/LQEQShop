# Copiar a .env en el servidor. Este archivo no se sube al repositorio.

# Dominios que la app acepta. Cualquier otro Host se rechaza.
LQEQ_HOSTS=loqueellasquieren.com.ar,www.loqueellasquieren.com.ar

# 1 cuando está detrás de HTTPS: cookie del panel Secure + HSTS.
LQEQ_HTTPS=1

# 1 cuando hay un proxy adelante (nginx/Caddy): la IP real sale de X-Forwarded-For.
LQEQ_TRUST_PROXY=1

# PIN inicial del panel, solo se usa la primera vez sobre una base vacía.
# Sin definir queda "1234" y el panel obliga a cambiarlo al primer ingreso.
LQEQ_ADMIN_PIN=
